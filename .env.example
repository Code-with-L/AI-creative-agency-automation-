# Copy to .env and fill in real values. NEVER commit .env.
# All keys/secrets come from the environment only.

# Provider (only "gemini" is implemented in Phase 1).
LLM_PROVIDER=gemini

# API key. Leave blank in the committed example.
# Either LLM_API_KEY or the provider-native GEMINI_API_KEY is accepted.
LLM_API_KEY=

# Endpoint template. {model} is substituted per stage.
LLM_ENDPOINT_TEMPLATE=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# Model ids are intentionally left blank: there is no built-in default.
# Set LLM_MODEL to use one model for every stage, or override per stage below.
# TODO: confirm the exact model ids you are entitled to before going live.
LLM_MODEL=
LLM_MODEL_INTAKE=
LLM_MODEL_CREATIVE=
LLM_MODEL_AUDIT=
LLM_MODEL_BRAND_AUDIT=

# Retry / timeout / quota guard.
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_BACKOFF_BASE=2
LLM_DAILY_QUOTA=50
LLM_ENFORCE_QUOTA=true
LLM_QUOTA_STATE_PATH=.data/quota.json
# HARM_CATEGORY_* threshold sent with every request (Gemini docs).
LLM_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Opt-in: also send generationConfig.responseSchema (enforce shape server-side).
LLM_RESPONSE_SCHEMA=false
